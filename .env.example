# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model alias or version
GEMINI_MODEL="gemini-flash-latest"

# DATABASE_URL: PostgreSQL Connection URL for Neon Serverless database
DATABASE_URL="postgresql://username:password@ep-cool-sample.eu-central-1.aws.neon.tech/yoe?sslmode=require"

# JWT_SECRET: Cryptographically signed secret for user session tokens
JWT_SECRET="b3f32c21405f09438d6fdf42154cc825ee30b8fdbaa805de7f6ec5a66783b4c0"
